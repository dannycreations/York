{
  "name": "york",
  "version": "2.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "type": "module",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "npm run format && tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x got,@types/node,pnpm",
    "prepare": "husky && effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.4",
    "@vegapunk/utilities": "^1.0.79",
    "dotenv": "^18.0.10",
    "effect": "^4.1.4",
    "got": "11.x",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "user-agents": "^2.1.246"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.70.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sapphire/ts-config": "^6.0.0",
    "@types/node": "24.x",
    "@types/user-agents": "^1.0.4",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.28.2"
}
